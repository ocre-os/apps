# MICRO-APPS LAB — private demonstration, no real customer data
Options -Indexes
AuthType Basic
AuthName "Micro-Apps LAB - acceso privado"
AuthBasicProvider file
AuthUserFile /home/ocre/public_html/apps/micro-apps-lab/.htpasswd
Require valid-user
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Cache-Control "private, no-store"
  Header always set Permissions-Policy "geolocation=(), microphone=()"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-ea9Lh/SYms3JCB7pcjDvZTIQpFtGF+/JqZ2SJjFGSmc='; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
</IfModule>
<FilesMatch "^\.(htpasswd|htaccess)$">
  Require all denied
</FilesMatch>
