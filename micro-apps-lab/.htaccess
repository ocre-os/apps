# TEMPORARY CONTAINMENT — no access until private auth credentials are rotated.
# The initial .htpasswd was committed to a public Git repository and must not be reused.
Options -Indexes
Require all denied
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Cache-Control "private, no-store"
  Header always set Permissions-Policy "geolocation=(), microphone=()"
</IfModule>
<FilesMatch "^\\.(htpasswd|htaccess)$">
  Require all denied
</FilesMatch>
